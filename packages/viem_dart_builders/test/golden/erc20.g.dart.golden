bool _deepEquals(Object? a, Object? b) {
  if (identical(a, b)) return true;
  if (a is List && b is List) {
    if (a.length != b.length) return false;
    for (var i = 0; i < a.length; i++) {
      if (!_deepEquals(a[i], b[i])) return false;
    }
    return true;
  }
  return a == b;
}

int _deepHash(Object? value) {
  if (value is List) {
    return Object.hashAll(value.map(_deepHash));
  }
  return value.hashCode;
}

/// Generated typed event-data class for the `Transfer` event — see `TypeMapper`/`buildEventMethods`.
class TransferEvent {
  const TransferEvent({
    required this.from,
    required this.to,
    required this.value,
  });

  final String from;

  final String to;

  final BigInt value;

  @override
  bool operator ==(Object other) {
    return identical(this, other) ||
        (other is TransferEvent &&
            _deepEquals(other.from, from) &&
            _deepEquals(other.to, to) &&
            _deepEquals(other.value, value));
  }

  @override
  int get hashCode {
    return Object.hashAll([_deepHash(from), _deepHash(to), _deepHash(value)]);
  }

  @override
  String toString() {
    return 'TransferEvent(from: $from, to: $to, value: $value)';
  }
}

/// Read-only typed bindings for the `Erc20` contract's ABI — generated by `viem_dart_builders` from its `@GenerateAbi` annotation. See `Erc20WalletContract` for write methods.
class Erc20Contract {
  const Erc20Contract({required this.client, required this.address});

  final PublicClient client;

  final String address;

  /// Calls the `balanceOf` view/pure function.
  Future<BigInt> balanceOf({
    required String owner,
    BigInt? blockNumber,
    String blockTag = 'latest',
  }) async {
    final raw = await client.readContract(
      address: address,
      abi: const AbiFunction(
        name: 'balanceOf',
        inputs: [AbiParameter(name: 'owner', type: 'address')],
        outputs: [AbiParameter(name: '', type: 'uint256')],
        stateMutability: 'view',
      ),
      args: [owner],
      blockNumber: blockNumber,
      blockTag: blockTag,
    );
    return raw as BigInt;
  }

  /// Fetches past `Transfer` events.
  Future<List<TransferEvent>> getTransferEvents({
    String? from,
    String? to,
    BigInt? fromBlockNumber,
    String fromBlockTag = 'earliest',
    BigInt? toBlockNumber,
    String toBlockTag = 'latest',
  }) async {
    final maps = await client.getContractEvents(
      address: address,
      event: const AbiEvent(
        name: 'Transfer',
        inputs: [
          AbiParameter(name: 'from', type: 'address', indexed: true),
          AbiParameter(name: 'to', type: 'address', indexed: true),
          AbiParameter(name: 'value', type: 'uint256', indexed: false),
        ],
        anonymous: false,
      ),
      args: {'from': ?from, 'to': ?to},
      fromBlockNumber: fromBlockNumber,
      fromBlockTag: fromBlockTag,
      toBlockNumber: toBlockNumber,
      toBlockTag: toBlockTag,
    );
    return maps
        .map(
          (m) => TransferEvent(
            from: m['from'] as String,
            to: m['to'] as String,
            value: m['value'] as BigInt,
          ),
        )
        .toList();
  }

  /// Watches for new `Transfer` events.
  Stream<TransferEvent> watchTransferEvent({
    String? from,
    String? to,
    Duration pollingInterval = const Duration(seconds: 4),
  }) async* {
    await for (final m in client.watchContractEvent(
      address: address,
      event: const AbiEvent(
        name: 'Transfer',
        inputs: [
          AbiParameter(name: 'from', type: 'address', indexed: true),
          AbiParameter(name: 'to', type: 'address', indexed: true),
          AbiParameter(name: 'value', type: 'uint256', indexed: false),
        ],
        anonymous: false,
      ),
      args: {'from': ?from, 'to': ?to},
      pollingInterval: pollingInterval,
    )) {
      yield TransferEvent(
        from: m['from'] as String,
        to: m['to'] as String,
        value: m['value'] as BigInt,
      );
    }
  }
}

/// Write-capable typed bindings for the `Erc20` contract's ABI — generated by `viem_dart_builders`. Extends `Erc20Contract` for its read methods; requires a `WalletClient` (not just a `PublicClient`) to construct.
class Erc20WalletContract extends Erc20Contract {
  const Erc20WalletContract({
    required WalletClient client,
    required String address,
  }) : super(client: client, address: address);

  WalletClient get _walletClient => client as WalletClient;

  /// Calls the `transfer` nonpayable function, signing and submitting the transaction.
  Future<String> transfer({
    required String to,
    required BigInt amount,
    String? from,
    BigInt? value,
    BigInt? gas,
    BigInt? maxFeePerGas,
    BigInt? maxPriorityFeePerGas,
    int? nonce,
  }) => _walletClient.writeContract(
    address: address,
    abi: const AbiFunction(
      name: 'transfer',
      inputs: [
        AbiParameter(name: 'to', type: 'address'),
        AbiParameter(name: 'amount', type: 'uint256'),
      ],
      outputs: [AbiParameter(name: '', type: 'bool')],
      stateMutability: 'nonpayable',
    ),
    args: [to, amount],
    from: from,
    value: value,
    gas: gas,
    maxFeePerGas: maxFeePerGas,
    maxPriorityFeePerGas: maxPriorityFeePerGas,
    nonce: nonce,
  );
}
